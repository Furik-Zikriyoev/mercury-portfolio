# Скопировать в .env и вставить свои ключи. .env в git не попадает.

# https://aistudio.google.com/apikey — бесплатный уровень
GEMINI_API_KEY=
# необязательно: другая модель картинок
GEMINI_IMAGE_MODEL=

# https://platform.openai.com/api-keys — платный, поставьте лимит расходов в Billing → Limits
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
